{
	"schemaVersion": 1,
	"id": "mehburity",
	"version": "${version}",
	"name": "Mehburity",
	"description": "A floating neon-cyan AI companion inspired by Verity: chats through Gemini, fights for you, mines, builds houses and turns into an 18-block demon when angered. Pitch-dark nights, a flashlight and things watching from the dark.",
	"authors": [
		"Mehbur07"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/mehburity/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mehbur.mehburity.MehburityMod"
		],
		"client": [
			"com.mehbur.mehburity.client.MehburityClient"
		],
		"modmenu": [
			"com.mehbur.mehburity.client.screen.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "mehburity.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
